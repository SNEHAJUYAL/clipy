+  it("reads dshow devices that offer audio alongside video, in either order", () => {
+    expect(parseDshowAudioDevices(DSHOW_MULTI_TYPE)).toEqual(["Cam Link 4K", "HD Webcam C920", "Microphone (Realtek(R) Audio)"]);
